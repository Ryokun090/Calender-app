# このファイルを application-local.yml という名前でコピーして使うこと。
# application-local.yml は .gitignore 対象なので、各自のパスワードがGitに流れる心配はない。

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/calendar_app?useSSL=false&serverTimezone=Asia/Tokyo&characterEncoding=utf8
    username: root
    password: ここに各自のMySQLパスワードを入れる
