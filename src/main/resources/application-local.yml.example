spring:
  datasource:
    url: jdbc:mysql://localhost:3306/calendar_app?useSSL=false&serverTimezone=Asia/Tokyo&characterEncoding=utf8
    username: root
    password: ここに自分のMySQLのパスワード
  mail:
    host: smtp.gmail.com
    port: 587
    username: ここに送信用Gmailアドレス
    password: ここにGoogleのアプリパスワード(16桁)
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
          ssl:
            trust: smtp.gmail.com