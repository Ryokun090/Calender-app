<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hakkushon.calendarapp.mapper.PollResponseMapper">

    <resultMap id="responseResultMap" type="com.hakkushon.calendarapp.domain.PollResponse">
        <id property="id" column="id"/>
        <result property="candidateId" column="candidate_id"/>
        <result property="userId" column="user_id"/>
        <result property="response" column="response"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- poll_responsesには(candidate_id, user_id)のUNIQUE制約があるのでON DUPLICATE KEYで上書きする -->
    <insert id="upsert">
        INSERT INTO poll_responses (candidate_id, user_id, response, created_at, updated_at)
        VALUES (#{candidateId}, #{userId}, #{response}, NOW(), NOW())
        ON DUPLICATE KEY UPDATE
            response = VALUES(response),
            updated_at = NOW()
    </insert>

    <select id="findByCandidateIds" resultMap="responseResultMap">
        SELECT id, candidate_id, user_id, response, created_at, updated_at
        FROM poll_responses
        WHERE candidate_id IN
        <foreach item="id" collection="candidateIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
