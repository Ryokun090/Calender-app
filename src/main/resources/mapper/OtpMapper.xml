<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hakkushon.calendarapp.mapper.OtpMapper">

    <resultMap id="otpResultMap" type="com.hakkushon.calendarapp.domain.OtpCode">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="code" column="code"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="isUsed" column="is_used"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO otp_codes (user_id, code, expires_at, is_used)
        VALUES (#{userId}, #{code}, #{expiresAt}, false)
    </insert>

    <select id="findLatestUnusedByUserId" resultMap="otpResultMap">
        SELECT id, user_id, code, expires_at, is_used, created_at
        FROM otp_codes
        WHERE user_id = #{userId} AND is_used = false
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <update id="markUsed">
        UPDATE otp_codes SET is_used = true WHERE id = #{id}
    </update>

</mapper>
