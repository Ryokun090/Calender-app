<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hakkushon.calendarapp.mapper.ScheduleMapper">

    <resultMap id="scheduleResultMap" type="com.hakkushon.calendarapp.domain.Schedule">
        <id property="id" column="id"/>
        <result property="calendarId" column="calendar_id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="location" column="location"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByCalendarAndRange" resultMap="scheduleResultMap">
        SELECT id, calendar_id, title, description, location, start_time, end_time, created_by, created_at, updated_at
        FROM schedules
        WHERE calendar_id = #{calendarId}
          AND start_time &lt; #{rangeEnd}
          AND end_time &gt; #{rangeStart}
        ORDER BY start_time ASC
    </select>

</mapper>
