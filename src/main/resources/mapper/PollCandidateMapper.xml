<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hakkushon.calendarapp.mapper.PollCandidateMapper">

    <resultMap id="candidateResultMap" type="com.hakkushon.calendarapp.domain.PollCandidate">
        <id property="id" column="id"/>
        <result property="pollId" column="poll_id"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO poll_candidates (poll_id, start_time, end_time)
        VALUES (#{pollId}, #{startTime}, #{endTime})
    </insert>

    <select id="findById" resultMap="candidateResultMap">
        SELECT id, poll_id, start_time, end_time
        FROM poll_candidates
        WHERE id = #{id}
    </select>

    <select id="findByPollId" resultMap="candidateResultMap">
        SELECT id, poll_id, start_time, end_time
        FROM poll_candidates
        WHERE poll_id = #{pollId}
        ORDER BY start_time ASC
    </select>

</mapper>
